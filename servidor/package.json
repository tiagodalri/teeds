{
  "name": "teeds-motor",
  "private": true,
  "type": "module",
  "description": "O motor dos robos da Teeds rodando fora do navegador.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/teste.ts src/login.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs",
    "teste": "node dist/teste.mjs",
    "login": "node dist/login.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}