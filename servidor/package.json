{
  "name": "teeds-motor",
  "private": true,
  "type": "module",
  "description": "O motor dos robos da Teeds rodando fora do navegador.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/teste.ts src/servidor.ts src/teste-limites.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs",
    "teste": "node dist/teste.mjs",
    "servidor": "node dist/servidor.mjs",
    "travas": "npm run build --silent && node dist/teste-limites.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  }
}
